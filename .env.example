APP_NAME=LipariBank AI
ENVIRONMENT=development
DEBUG=false
DATABASE_URL=postgresql+asyncpg://lipari:lipari@localhost:5432/lipari_ai
JWT_SECRET=
OPENAI_API_KEY=
# Vuoto = OpenAI ufficiale. Per un endpoint compatibile:
# Groq:       https://api.groq.com/openai/v1
# OpenRouter: https://openrouter.ai/api/v1
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
# Embedding: local = fastembed (nessuna chiave), openai = api.openai.com
EMBEDDING_BACKEND=local
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384
# Serve solo con EMBEDDING_BACKEND=openai
EMBEDDING_API_KEY=
# vector = solo similarità; hybrid = similarità + ricerca lessicale
RETRIEVAL_MODE=vector
DEFAULT_MODEL=gpt-4o-mini
MAX_TOKENS_PER_REQUEST=2000
CORS_ORIGINS=["http://localhost:5173"]
DAILY_BUDGET_EUR=5.00
